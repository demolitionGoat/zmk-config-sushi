# This file was generated from a template. Edit it to match your keyboard.
# See https://docs.zephyrproject.org/4.1.0/hardware/porting/board_porting.html#write-kconfig-files
# for more information.

if BOARD_SPLIT_SUSHI_LENZ_LEFT

config ZMK_KEYBOARD_NAME
    default "split-sushi-lenz"

config ZMK_SPLIT_ROLE_CENTRAL
    default y
	
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
	default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
	defaul y

endif # BOARD_SPLIT_SUSHI_LENZ_LEFT

if BOARD_SPLIT_SUSHI_LENZ_LEFT || BOARD_SPLIT_SUSHI_LENZ_RIGHT

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config BT
	default y

# config ZMK_BLE
#	 default y


# config BT_CTLR
#     default BT

endif # BOARD_SPLIT_SUSHI_LENZ_LEFT || BOARD_SPLIT_SUSHI_LENZ_RIGHT
