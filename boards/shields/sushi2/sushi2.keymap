// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
	
    behaviors {
		// bluetooth layer controls
		btESC: bluetooth_clear_slot_or_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&bt BT_CLR>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt0N7: bluetooth_slot_0_or_keypad_nr7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp KP_N7>, <&bt BT_SEL 0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt1N8: bluetooth_slot_1_or_keypad_nr8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp KP_N8>, <&bt BT_SEL 1>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt2N9: bluetooth_slot_2_or_keypad_nr9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp KP_N9>, <&bt BT_SEL 2>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt3SL: bluetooth_slot_3_or_slash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SLASH>, <&bt BT_SEL 3>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt4PS: bluetooth_slot_4_or_printscreen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PSCRN>, <&bt BT_SEL 4>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    // default keymap
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
			display-name = "base";
            bindings = <
                &kp GRAVE	  &kp DE_Q  &kp W     &kp O     &kp U     &kp DE_Z       &kp B     &kp F     &kp J     &kp G        &kp P      &kp DE_SQT
                &kp TAB       &kp A     &kp S     &kp DE_E  &kp R     &kp D          &kp H     &kp I     &kp N     &kp L        &kp T      &kp RET
                &kp DE_LT     &kp DE_Y  &kp X     &kp C     &kp V                              &kp K     &kp DE_M  &kp DE_COMMA &kp DE_DOT &kp DE_MINUS
                                                                 &kp LGUI                &kp DEL
                                                                   &kp LSHIFT          &mo 1
                                                                     &kp SPACE       &kp BSPC
                                                                       &kp LCTRL   &kp LALT
            >;
			sensor-bindings = <
				&inc_dec_kp RIGHT    LEFT
				&inc_dec_kp UP       DOWN
			>;
        };
		righttoggle_layer { // Layer 1
			display-name = "toggled";
            bindings = <
                &kp DE_EXCL &kp DE_BSLH     &kp DE_DQT  &kp DE_O_UMLAUT &kp DE_U_UMLAUT &kp DE_QMARK   &btESC    &bt0N7    &bt1N8    &bt2N9    &bt3SL        &bt4PS
                &trans      &kp DE_A_UMLAUT &kp DE_LBRC &kp LPAR        &kp RPAR        &kp DE_RBRC    &kp DE_N0 &kp N4    &kp N5    &kp N6    &kp DE_PLUS   &trans
                &kp F5      &kp F12         &kp DE_SZ   &kp DE_LBKT     &kp DE_RBKT                              &kp KP_N1 &kp KP_N2 &kp N3    &trans        &trans
                                                                                 &kp C_PP                &kp C_MUTE
                                                                                   &trans              &trans
                                                                                     &trans          &trans
                                                                                       &trans      &trans
            >;
			sensor-bindings = <
				&inc_dec_kp C_NEXT	    C_PREV
				&inc_dec_kp C_VOL_UP    C_VOL_DN
			>;
        };
    };
};
