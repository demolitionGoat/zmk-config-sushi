// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
			display-name = "base";
            bindings = <
                &kp DE_CARET  &kp DE_Q  &kp W     &kp O     &kp U     &kp DE_Z       &kp B     &kp F     &kp J     &kp G       &kp P      &kp SQT
                &kp TAB       &kp A     &kp S     &kp DE_E  &kp R     &kp D          &kp H     &kp I     &kp N     &kp L       &kp T      &kp RET
                &kp DE_LT     &kp DE_Y  &kp X     &kp C     &kp V                              &kp K     &kp DE_M  &kp DE_SEMI &kp DE_DOT &kp DE_MINUS
                                                                 &kp LGUI                &kp DEL
                                                                   &kp LSHIFT          &mo 1
                                                                     &kp SPACE       &kp BSPC
                                                                       &kp LCTRL   &kp LALT
            >;
			sensor-bindings = <
				&inc_dec_kp RIGHT    LEFT
				&inc_dec_kp UP       DOWN
			>;
        };
		righttoggle_layer { // Layer 1
			display-name = "toggled";
            bindings = <
                &kp DE_EXCL &kp DE_BSLH     &kp DE_DQT  &kp DE_O_UMLAUT &kp DE_U_UMLAUT &kp DE_QMARK   &kp ESC   &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp DE_SLASH  &kp PSCRN
                &trans      &kp DE_A_UMLAUT &kp DE_LBRC &kp LPAR        &kp RPAR        &kp DE_RBRC    &kp N1    &kp N4    &kp N5    &kp N6    &kp DE_PLUS   &trans
                &kp F5      &kp F12         &kp DE_SZ   &kp DE_LBKT     &kp DE_RBKT                              &kp KP_N1 &kp KP_N2 &kp N3    &trans        &trans
                                                                                 &trans                  &kp INS
                                                                                   &trans              &trans
                                                                                     &trans          &trans
                                                                                       &trans      &trans
            >;
			sensor-bindings = <
				&inc_dec_kp &trans	&trans 
				&inc_dec_kp &trans	&trans
			>;
        };
    };
};
